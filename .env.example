# 豆包（字节方舟）API 密钥
DOUBAO_API_KEY=ark-945261bb-64aa-415d-81e7-c17105031720-3c8f5

# 豆包模型接入点（模型名或接入点 ID）
DOUBAO_MODEL=doubao-seed-2.1-turbo

# 字节方舟 OpenAI 兼容接口地址（一般无需修改）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
