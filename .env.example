# ============================================
# 旅行规划助手 - 环境变量模板
# 使用方法：复制本文件为 .env，并填入真实值
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库
# ============================================

# 豆包（字节方舟）API 密钥
DOUBAO_API_KEY=ark-945261bb-64aa-415d-81e7-c17105031720-3c8f5

# 豆包模型接入点（模型名或接入点 ID）
DOUBAO_MODEL=doubao-seed-2.1-turbo

# 字节方舟 OpenAI 兼容接口地址（一般无需修改）
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# PostgreSQL 数据库连接
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_plan

# Redis 缓存连接
REDIS_URL=redis://localhost:6379

# ============================================
# Docker 部署说明
# ============================================
# 使用 docker compose 部署时，本文件会被 docker-compose 自动读取，
# 用于注入 DOUBAO_API_KEY 等敏感变量。
# DATABASE_URL / REDIS_URL 已在 docker-compose.yml 中写死（指向容器内服务），
# 无需在此配置。
#
# 启动命令：
#   docker compose up --build
# 访问地址：
#   http://localhost:8080
