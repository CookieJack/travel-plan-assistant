{
  "name": "travel-plan-assistant",
  "version": "0.1.0",
  "description": "多Agent旅行规划助手 - pnpm monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --sort build",
    "dev": "pnpm --filter @travel/cli dev",
    "dev:api": "pnpm --filter @travel/api dev",
    "dev:web": "pnpm --filter @travel/web dev",
    "build:web": "pnpm --filter @travel/web build",
    "start:api": "pnpm --filter @travel/api start",
    "db:push": "pnpm --filter @travel/api prisma:push",
    "db:studio": "pnpm --filter @travel/api prisma:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
