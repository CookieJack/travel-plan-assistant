{
  "name": "@travel/llm",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --external dotenv",
    "dev": "tsup src/index.ts --format esm --out-dir dist --external dotenv --watch"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.11",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
